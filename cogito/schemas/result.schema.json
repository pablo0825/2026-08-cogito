{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.local/schemas/result.schema.json",
  "title": "Cogito Finalization Result",
  "description": "Written before the atomic final commit. The final commit id belongs to the finalization event and generated report, avoiding a self-reference.",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "package_hash", "effective_contract_hash", "integration_commits", "slice_dispositions", "checks", "reviews", "amendments", "human_gate", "remaining_risks"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "run_id": {"type": "string", "pattern": "^(DEV|MNT)-[A-Za-z0-9._-]+$"},
    "status": {"const": "accepted"},
    "package_hash": {"$ref": "#/$defs/contentHash"},
    "effective_contract_hash": {"$ref": "#/$defs/contentHash"},
    "integration_commits": {"type": "array", "items": {"$ref": "#/$defs/gitObject"}, "uniqueItems": true},
    "slice_dispositions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9._-]*$"}, "additionalProperties": {"enum": ["accepted", "cancelled", "superseded"]}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "status", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "blocked"]}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "reviews": {"type": "array", "items": {"type": "object", "required": ["reviewer", "outcome"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "implementer": {"type": "string", "minLength": 1}, "outcome": {"enum": ["approved", "fixed", "blocked", "exempt"]}, "commit_id": {"$ref": "#/$defs/gitObject"}}, "additionalProperties": true}},
    "amendments": {"type": "array", "items": {"type": "object", "required": ["id", "commit_id"], "properties": {"id": {"type": "string", "minLength": 1}, "commit_id": {"$ref": "#/$defs/gitObject"}}, "additionalProperties": true}},
    "human_gate": {"type": "object", "required": ["required", "outcome"], "properties": {"required": {"type": "boolean"}, "outcome": {"enum": ["approved", "not-required"]}}, "additionalProperties": false},
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"gitObject": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
