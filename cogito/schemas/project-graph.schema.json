{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.local/schemas/project-graph.schema.json",
  "title": "Cogito Project Graph",
  "description": "Slice ids are object keys, so duplicate ids are structurally impossible.",
  "type": "object",
  "required": ["schema_version", "active_run_id", "slices", "dependencies"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "active_run_id": {"type": ["string", "null"], "pattern": "^(DEV|MNT)-[A-Za-z0-9._-]+$"},
    "slices": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "disposition", "dependencies", "lineage"],
        "properties": {
          "kind": {"enum": ["feature", "change", "correction"]},
          "disposition": {"enum": ["planned", "active", "accepted", "cancelled", "superseded"]},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "lineage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "spec": {"$ref": "#/$defs/document"},
          "plan": {"$ref": "#/$defs/document"},
          "introduced_by": {"type": "string", "pattern": "^(DEV|MNT)-[A-Za-z0-9._-]+$"},
          "completed_by": {"type": ["string", "null"], "pattern": "^(DEV|MNT)-[A-Za-z0-9._-]+$"}
        },
        "additionalProperties": false
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "contract": {"type": "string"}}, "additionalProperties": false}}
  },
  "$defs": {"document": {"type": "object", "required": ["path", "hash"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
