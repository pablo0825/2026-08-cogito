{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.local/schemas/check-evidence.schema.json",
  "title": "Cogito Controlled Check Evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "check_id", "status", "passed", "exit_code", "timed_out", "output_limit_exceeded", "termination_degraded", "output_limit_bytes", "stdout_bytes", "stderr_bytes", "duration_seconds", "started_at", "head_commit", "tree_hash", "worktree_snapshot_hash", "pre_worktree_snapshot_hash", "post_worktree_snapshot_hash", "worktree_changed_during_check", "worktree_binding", "check_hash", "effective_contract_hash", "argv", "cwd", "stdout", "stderr", "truncated", "evidence_path"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "run_id": {"type": "string", "pattern": "^(DEV|MNT)-[A-Za-z0-9._-]+$"},
    "check_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "status": {"enum": ["passed", "failed"]},
    "passed": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "output_limit_exceeded": {"type": "boolean"},
    "termination_degraded": {"type": "boolean"},
    "output_limit_bytes": {"type": "integer", "minimum": 1024, "maximum": 104857600},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "number", "minimum": 0},
    "started_at": {"type": "string", "minLength": 1},
    "head_commit": {"$ref": "#/$defs/gitObject"},
    "tree_hash": {"$ref": "#/$defs/contentHash"},
    "worktree_snapshot_hash": {"$ref": "#/$defs/contentHash"},
    "pre_worktree_snapshot_hash": {"$ref": "#/$defs/contentHash"},
    "post_worktree_snapshot_hash": {"$ref": "#/$defs/contentHash"},
    "worktree_changed_during_check": {"type": "boolean"},
    "worktree_binding": {"type": "object"},
    "check_hash": {"$ref": "#/$defs/contentHash"},
    "effective_contract_hash": {"$ref": "#/$defs/contentHash"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "truncated": {"type": "boolean"},
    "evidence_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
