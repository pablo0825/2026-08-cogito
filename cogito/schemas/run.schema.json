{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.local/schemas/run.schema.json",
  "title": "Cogito Run Projection",
  "type": "object",
  "required": ["schema_version", "run_id", "kind", "state", "sequence", "counters", "tasks", "max_workers", "limits"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "run_id": {"type": "string"},
    "kind": {"enum": ["feature", "change", "correction", "maintenance", "documentation"]},
    "state": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "last_event_hash": {"type": "string"},
    "package_path": {"type": ["string", "null"]},
    "package_hash": {"type": ["string", "null"]},
    "effective_contract_hash": {"type": ["string", "null"]},
    "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "tasks": {"type": "object"},
    "max_workers": {"type": "integer", "minimum": 1, "maximum": 3},
    "project_graph_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "evidence": {"type": "object"},
    "blocked_from": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
